@import "io.lg";
@import "core.lg";
@import "heap.lg";
@import "fs.lg";
@import "elf.lg";

let char sh_line[128];
let char sh_argbuf[32];
let char sh_argv_buf[192];
let int sh_argv_off[8];
let int sh_ptrs[8];
let int sh_argc;
let int user_frame[8];

func str_len(p) { let char* s = p; let i = 0; while (s[i] != 0) { i += 1; } return i; }
func str_put(p) { let char* s = p; let i = 0; while (s[i] != 0) { serial_putc(s[i]); i += 1; } return 0; }
func str_eq(a, b) {
    let char* x = a; let char* y = b; let i = 0;
    while (1) { if (x[i] != y[i]) { return 0; } if (x[i] == 0) { return 1; } i += 1; }
    return 0;
}
func str_puts_at(b, start) {
    let char* s = b; let i = start;
    while (s[i] != 0) { serial_putc(s[i]); i += 1; }
    return 0;
}
func sh_copy_arg(b, start, dst) {
    let char* s = b; let char* d = dst; let i = 0;
    while (s[start + i] != 0) { d[i] = s[start + i]; i += 1; }
    d[i] = 0; return i;
}
func str_parse_dec(b, start) {
    let char* s = b; let v = 0; let i = start;
    while (s[i] >= '0' && s[i] <= '9') { v = v * 10 + (s[i] - '0'); i += 1; }
    return v;
}

func sh_parse_args(b, start) {
    let char* s = b; let char* d = sh_argv_buf;
    let i = start; let o = 0; let n = 0; let go = 1;
    while (go != 0) {
        while (s[i] == ' ') { i += 1; }
        if (s[i] == 0) { go = 0; }
        else if (n >= 8) { go = 0; }
        else {
            sh_argv_off[n] = o;
            n += 1;
            let tok = 1;
            while (tok != 0) {
                if (s[i] == 0 || s[i] == ' ') { tok = 0; }
                else { d[o] = s[i]; o += 1; i += 1; }
            }
            d[o] = 0; o += 1;
        }
    }
    sh_argc = n;
    return n;
}

func sh_rand_byte(k) {
    let s = pit_ticks * 1103515245 + 12345 + k * 2654435761;
    return (s >> 13) & 255;
}

func sh_build_stack(img, entry) {
    let sp = USER_STACK_TOP;
    let k = sh_argc - 1;
    while (k >= 0) {
        let a0 = sh_argv_buf + sh_argv_off[k]; let char* a = a0;
        let sz = str_len(a) + 1;
        sp = sp - sz;
        let j = 0;
        while (j < sz) { mem_write8(sp, j, mem_read8(a, j)); j += 1; }
        sh_ptrs[k] = sp;
        k -= 1;
    }

    let e0 = sh_argv_buf + sh_argv_off[0]; let char* ef = e0;
    let esz = str_len(ef) + 1;
    sp = sp - esz;
    let j2 = 0;
    while (j2 < esz) { mem_write8(sp, j2, mem_read8(ef, j2)); j2 += 1; }
    let execfn = sp;

    sp = sp - 16;
    let r = 0;
    while (r < 16) { mem_write8(sp, r, sh_rand_byte(r)); r += 1; }
    let randp = sp;

    let phoff = mem_read64(img, 32);
    let phent = mem_read16(img, 54);
    let phnum = mem_read16(img, 56);
    let base = 0;
    let pi = 0;
    while (pi < phnum) {
        let pb = phoff + pi * phent;
        if (mem_read32(img, pb) == 1) { base = mem_read64(img, pb + 16); pi = phnum; }
        else { pi += 1; }
    }
    let phdr = base + phoff;

    sp = sp - (sp & 15);
    let npush = 41 + sh_argc;
    if ((npush & 1) != 0) { sp = sp - 8; mem_write64(sp, 0, 0); }

    sp = sp - 8; mem_write64(sp, 0, 0); sp = sp - 8; mem_write64(sp, 0, 0);
    sp = sp - 8; mem_write64(sp, 0, 0); sp = sp - 8; mem_write64(sp, 0, 33);
    sp = sp - 8; mem_write64(sp, 0, execfn); sp = sp - 8; mem_write64(sp, 0, 31);
    sp = sp - 8; mem_write64(sp, 0, 0); sp = sp - 8; mem_write64(sp, 0, 26);
    sp = sp - 8; mem_write64(sp, 0, randp); sp = sp - 8; mem_write64(sp, 0, 25);
    sp = sp - 8; mem_write64(sp, 0, 0); sp = sp - 8; mem_write64(sp, 0, 23);
    sp = sp - 8; mem_write64(sp, 0, 100); sp = sp - 8; mem_write64(sp, 0, 17);
    sp = sp - 8; mem_write64(sp, 0, 0); sp = sp - 8; mem_write64(sp, 0, 16);
    sp = sp - 8; mem_write64(sp, 0, 0); sp = sp - 8; mem_write64(sp, 0, 14);
    sp = sp - 8; mem_write64(sp, 0, 0); sp = sp - 8; mem_write64(sp, 0, 13);
    sp = sp - 8; mem_write64(sp, 0, 0); sp = sp - 8; mem_write64(sp, 0, 12);
    sp = sp - 8; mem_write64(sp, 0, 0); sp = sp - 8; mem_write64(sp, 0, 11);
    sp = sp - 8; mem_write64(sp, 0, entry); sp = sp - 8; mem_write64(sp, 0, 9);
    sp = sp - 8; mem_write64(sp, 0, 0); sp = sp - 8; mem_write64(sp, 0, 8);
    sp = sp - 8; mem_write64(sp, 0, 0); sp = sp - 8; mem_write64(sp, 0, 7);
    sp = sp - 8; mem_write64(sp, 0, 4096); sp = sp - 8; mem_write64(sp, 0, 6);
    sp = sp - 8; mem_write64(sp, 0, phnum); sp = sp - 8; mem_write64(sp, 0, 5);
    sp = sp - 8; mem_write64(sp, 0, phent); sp = sp - 8; mem_write64(sp, 0, 4);
    sp = sp - 8; mem_write64(sp, 0, phdr); sp = sp - 8; mem_write64(sp, 0, 3);

    sp = sp - 8; mem_write64(sp, 0, 0);
    sp = sp - 8; mem_write64(sp, 0, 0);

    k = sh_argc - 1;
    while (k >= 0) { sp = sp - 8; mem_write64(sp, 0, sh_ptrs[k]); k -= 1; }

    sp = sp - 8; mem_write64(sp, 0, sh_argc);
    return sp;
}

func sh_readline(buf) {
    let char* b = buf; let n = 0;
    while (1) {
        let c = console_getc();
        if (c == 10 || c == 13) { serial_putc('\n'); b[n] = 0; return n; }
        if (c == 8 || c == 127) {
            if (n > 0) { n -= 1; serial_putc(8); serial_putc(' '); serial_putc(8); }
        } else if (c >= 32) {
            if (n < 127) { b[n] = c; n += 1; serial_putc(c); }
        }
    }
    return 0;
}

func sh_cmd_help() {
    serial_puts("commands:\n");
    serial_puts("  help            this text\n");
    serial_puts("  ls              list ramfs files\n");
    serial_puts("  cat <file>      dump a file (non-printable as '.')\n");
    serial_puts("  save <file> <lba>  write a ramfs file to disk sectors\n");
    serial_puts("  exec <file.elf> [args...]  load ELF via VFS and jump to ring3\n");
    serial_puts("  info            ticks / heap / file count\n");
    serial_puts("  heap <bytes>    alloc+free from kernel heap\n");
    serial_puts("  echo <text>     print text\n");
    serial_puts("  clear           clear screen\n");
    return 0;
}

func sh_cmd_info() {
    serial_puts("ticks="); serial_putn(pit_ticks); serial_putc('\n');
    serial_puts("heap: brk="); serial_putn(heap_brk); serial_puts(" holes="); serial_putn(heap_hole_n); serial_putc('\n');
    serial_puts("files="); serial_putn(fs_count()); serial_putc('\n');
    return 0;
}

func sh_cmd_clear() {
    vga_clear();
    return 0;
}

func sh_cmd_heap() {
    let char* ap = sh_argbuf;
    let n = str_parse_dec(ap, 0);
    if (n == 0) { n = 32; }
    let off = heap_alloc(n);
    serial_puts("alloc("); serial_putn(n); serial_puts(") -> off="); serial_putn(off);
    serial_puts("  brk="); serial_putn(heap_brk); serial_putc('\n');
    if (off >= 0) { heap_free(off, n); serial_puts("freed\n"); }
    return 0;
}

func sh_cmd_cat() {
    let char* ap = sh_argbuf;
    if (str_len(ap) == 0) { serial_puts("usage: cat <file>\n"); return 0; }
    let fd = fs_open(ap);
    if (fd < 0) { serial_puts("cat: no such file: "); str_put(ap); serial_putc('\n'); return 0; }
    let sz = fs_size(fd);
    let d0 = fs_file_data(fd); let char* d = d0;
    for i in 0..sz { let c = d[i]; if (c >= 32 && c < 127) { serial_putc(c); } else { serial_putc('.'); } }
    serial_putc('\n');
    return 0;
}

func sh_cmd_save() {
    if (sh_argc < 2) { serial_puts("usage: save <file> <lba>\n"); return 0; }
    let f0 = sh_argv_buf + sh_argv_off[0]; let char* fn = f0;
    let a0 = sh_argv_buf + sh_argv_off[1]; let char* as = a0;
    let fd = fs_open(fn);
    if (fd < 0) { serial_puts("save: no such file: "); str_put(fn); serial_putc('\n'); return 0; }
    let lba = str_parse_dec(as, 0);
    let nsect = (fs_size(fd) + 511) / 512;
    if (ata_write(lba, nsect, fs_file_data(fd)) != 0) { serial_puts("save: ata write failed\n"); return 0; }
    ata_flush();
    serial_puts("save: "); str_put(fn); serial_puts(" -> lba="); serial_putn(lba);
    serial_puts(" sectors="); serial_putn(nsect); serial_putc('\n');
    return 0;
}

func sh_cmd_exec() {
    if (sh_argc == 0) { serial_puts("usage: exec <elf-file> [args...]\n"); return 0; }
    let e0 = sh_argv_buf + sh_argv_off[0]; let char* ef = e0;
    let fd = fs_open(ef);
    if (fd < 0) { serial_puts("exec: no such file: "); str_put(ef); serial_putc('\n'); return 0; }
    let img0 = fs_file_data(fd); let char* img = img0;
    let entry = elf_load(img);
    user_setup_brk(elf_max_end);
    serial_puts("exec: "); str_put(ef); serial_puts(" entry="); serial_puthex(entry); serial_putc('\n');
    let sp = sh_build_stack(img, entry);
    let int* u = user_frame;
    u[0] = entry; u[1] = SEL_UCODE; u[2] = 0x2; u[3] = sp; u[4] = SEL_UDATA;
    let uf = user_frame;
    user_enter(uf);
    return 0;
}

func sh_dispatch(buf) {
    let char* b = buf;
    let ci = 0;
    while (b[ci] != 0 && b[ci] != ' ') { ci += 1; }
    let cmdend = ci;
    let ai = ci;
    while (b[ai] == ' ') { ai += 1; }
    let argstart = ai;
    b[cmdend] = 0;
    let char* cmd = b;
    if (cmdend == 0) { return 0; }
    let char* ab = sh_argbuf;
    if (str_eq(cmd, "help")) { sh_cmd_help(); return 0; }
    if (str_eq(cmd, "ls")) { fs_list(); return 0; }
    if (str_eq(cmd, "info")) { sh_cmd_info(); return 0; }
    if (str_eq(cmd, "trace")) { if (trace_sys == 0) { trace_sys = 1; serial_puts("trace on\n"); } else { trace_sys = 0; serial_puts("trace off\n"); } return 0; }
    if (str_eq(cmd, "clear")) { sh_cmd_clear(); return 0; }
    if (str_eq(cmd, "echo")) { str_puts_at(b, argstart); serial_putc('\n'); return 0; }
    if (str_eq(cmd, "heap")) { sh_copy_arg(b, argstart, ab); sh_cmd_heap(); return 0; }
    if (str_eq(cmd, "cat")) { sh_copy_arg(b, argstart, ab); sh_cmd_cat(); return 0; }
    if (str_eq(cmd, "exec")) { sh_parse_args(b, argstart); sh_cmd_exec(); return 0; }
    if (str_eq(cmd, "save")) { sh_parse_args(b, argstart); sh_cmd_save(); return 0; }
    serial_puts("unknown command: "); str_put(cmd); serial_puts(" (try 'help')\n");
    return 0;
}

func sh_run() {
    serial_puts("\nlgc-os microkernel. type 'help'.\n");
    sh_repl();
    return 0;
}

func sh_repl() {
    while (1) {
        serial_puts("lgc> ");
        let char* lp = sh_line;
        sh_readline(lp);
        sh_dispatch(lp);
    }
    return 0;
}

func sh_resume() {
    sti();
    serial_puts("exit=");
    let c = user_exit_code;
    if (c < 0) { serial_putc('-'); c = 0 - c; }
    serial_putn(c);
    serial_putc('\n');
    sh_repl();
    return 0;
}
