const VID = 0xB8000;
const COLS = 80;
const ROWS = 25;
const CUR = 0x170000;

const COMPORT = 0x3F8;
const LSR = 0x3FD;
const KBD_DATA = 0x60;
const KBD_STAT = 0x64;

let char kmap[128];
let int shift = 0;

func kbd_init() {
    let int i = 0;
    while (i < 128) { kmap[i] = 0; i += 1; }
    kmap[0x1C] = 10;
    kmap[0x0E] = 8;
    kmap[0x39] = ' ';
    kmap[0x02] = '1'; kmap[0x03] = '2'; kmap[0x04] = '3'; kmap[0x05] = '4'; kmap[0x06] = '5';
    kmap[0x07] = '6'; kmap[0x08] = '7'; kmap[0x09] = '8'; kmap[0x0A] = '9'; kmap[0x0B] = '0';
    kmap[0x29] = '`'; kmap[0x0C] = '-'; kmap[0x0D] = '='; kmap[0x1A] = '['; kmap[0x1B] = ']';
    kmap[0x2B] = 92; kmap[0x27] = ';'; kmap[0x28] = 39; kmap[0x33] = ','; kmap[0x34] = '.';
    kmap[0x35] = '/';
    kmap[0x1E] = 'a'; kmap[0x30] = 'b'; kmap[0x2E] = 'c'; kmap[0x20] = 'd'; kmap[0x12] = 'e';
    kmap[0x21] = 'f'; kmap[0x22] = 'g'; kmap[0x23] = 'h'; kmap[0x17] = 'i'; kmap[0x24] = 'j';
    kmap[0x25] = 'k'; kmap[0x26] = 'l'; kmap[0x32] = 'm'; kmap[0x31] = 'n'; kmap[0x18] = 'o';
    kmap[0x19] = 'p'; kmap[0x10] = 'q'; kmap[0x13] = 'r'; kmap[0x1F] = 's'; kmap[0x14] = 't';
    kmap[0x16] = 'u'; kmap[0x2F] = 'v'; kmap[0x11] = 'w'; kmap[0x2D] = 'x'; kmap[0x15] = 'y';
    kmap[0x2C] = 'z';
    return 0;
}

func kbd_decode(sc) {
    if (sc == 0x2A) { shift = 1; return 0; }
    if (sc == 0x36) { shift = 1; return 0; }
    if (sc == 0xAA) { shift = 0; return 0; }
    if (sc == 0xB6) { shift = 0; return 0; }
    if ((sc & 0x80) != 0) { return 0; }
    let int c = kmap[sc];
    if (c == 0) { return 0; }
    if (shift != 0) {
        if (c >= 'a' && c <= 'z') { c = c - 32; }
    }
    return c;
}

func console_getc() {
    while (1) {
        if ((inb(LSR) & 1) != 0) { return inb(COMPORT); }
        if ((inb(KBD_STAT) & 1) != 0) {
            let int r = kbd_decode(inb(KBD_DATA));
            if (r != 0) { return r; }
        }
    }
    return 0;
}

func vga_scroll() {
    let char* v = VID;
    let int n = (ROWS - 1) * COLS * 2;
    let int i = 0;
    while (i < n) { v[i] = v[i + COLS * 2]; i += 1; }
    let int j = (ROWS - 1) * COLS;
    while (j < ROWS * COLS) { v[j * 2] = ' '; v[j * 2 + 1] = 0x07; j += 1; }
    return 0;
}

func vga_cursor(idx) {
    outb(0x3D4, 0x0E); outb(0x3D5, (idx >> 7) & 255);
    outb(0x3D4, 0x0F); outb(0x3D5, idx & 255);
    return 0;
}

func vga_putc(ch) {
    let char* v = VID;
    let int* cp = CUR;
    let int idx = cp[0];
    if (ch == 10) {
        idx = (idx / COLS + 1) * COLS;
    } else if (ch == 8) {
        if (idx % COLS > 0) { idx -= 1; v[idx * 2] = ' '; v[idx * 2 + 1] = 0x07; }
    } else if (ch == 9) {
        idx = (idx + 8) & ~7;
        if (idx % COLS >= COLS) { idx = (idx / COLS) * COLS; }
    } else if (ch >= 32 && ch < 127) {
        v[idx * 2] = ch; v[idx * 2 + 1] = 0x07;
        idx += 1;
    }
    if (idx >= ROWS * COLS) { vga_scroll(); idx = (ROWS - 1) * COLS; }
    cp[0] = idx;
    vga_cursor(idx);
    return 0;
}

func vga_clear() {
    let char* v = VID;
    let int i = 0;
    while (i < ROWS * COLS) { v[i * 2] = ' '; v[i * 2 + 1] = 0x07; i += 1; }
    let int* cp = CUR;
    cp[0] = 0;
    vga_cursor(0);
    return 0;
}
