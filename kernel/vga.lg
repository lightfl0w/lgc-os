const VGA_MEM = 0xB8000;
const VGA_COLS = 80;
const VGA_ROWS = 25;
const VGA_CURSOR_ADDR = 0x170000;

const SERIAL_COM1 = 0x3F8;
const SERIAL_LSR = 0x3FD;
const KBD_DATA_PORT = 0x60;
const KBD_STATUS_PORT = 0x64;

let char kbd_map[128];
let int kbd_shift = 0;

func kbd_init() {
    let int i = 0;
    while (i < 128) { kbd_map[i] = 0; i += 1; }
    kbd_map[0x1C] = 10;
    kbd_map[0x0E] = 8;
    kbd_map[0x39] = ' ';
    kbd_map[0x02] = '1'; kbd_map[0x03] = '2'; kbd_map[0x04] = '3'; kbd_map[0x05] = '4'; kbd_map[0x06] = '5';
    kbd_map[0x07] = '6'; kbd_map[0x08] = '7'; kbd_map[0x09] = '8'; kbd_map[0x0A] = '9'; kbd_map[0x0B] = '0';
    kbd_map[0x29] = '`'; kbd_map[0x0C] = '-'; kbd_map[0x0D] = '='; kbd_map[0x1A] = '['; kbd_map[0x1B] = ']';
    kbd_map[0x2B] = 92; kbd_map[0x27] = ';'; kbd_map[0x28] = 39; kbd_map[0x33] = ','; kbd_map[0x34] = '.';
    kbd_map[0x35] = '/';
    kbd_map[0x1E] = 'a'; kbd_map[0x30] = 'b'; kbd_map[0x2E] = 'c'; kbd_map[0x20] = 'd'; kbd_map[0x12] = 'e';
    kbd_map[0x21] = 'f'; kbd_map[0x22] = 'g'; kbd_map[0x23] = 'h'; kbd_map[0x17] = 'i'; kbd_map[0x24] = 'j';
    kbd_map[0x25] = 'k'; kbd_map[0x26] = 'l'; kbd_map[0x32] = 'm'; kbd_map[0x31] = 'n'; kbd_map[0x18] = 'o';
    kbd_map[0x19] = 'p'; kbd_map[0x10] = 'q'; kbd_map[0x13] = 'r'; kbd_map[0x1F] = 's'; kbd_map[0x14] = 't';
    kbd_map[0x16] = 'u'; kbd_map[0x2F] = 'v'; kbd_map[0x11] = 'w'; kbd_map[0x2D] = 'x'; kbd_map[0x15] = 'y';
    kbd_map[0x2C] = 'z';
    return 0;
}

func kbd_decode(sc) {
    if (sc == 0x2A) { kbd_shift = 1; return 0; }
    if (sc == 0x36) { kbd_shift = 1; return 0; }
    if (sc == 0xAA) { kbd_shift = 0; return 0; }
    if (sc == 0xB6) { kbd_shift = 0; return 0; }
    if ((sc & 0x80) != 0) { return 0; }
    let int c = kbd_map[sc];
    if (c == 0) { return 0; }
    if (kbd_shift != 0) {
        if (c >= 'a' && c <= 'z') { c = c - 32; }
    }
    return c;
}

func console_getc() {
    while (1) {
        if ((inb(SERIAL_LSR) & 1) != 0) { return inb(SERIAL_COM1); }
        if ((inb(KBD_STATUS_PORT) & 1) != 0) {
            let int r = kbd_decode(inb(KBD_DATA_PORT));
            if (r != 0) { return r; }
        }
    }
    return 0;
}

func vga_scroll() {
    let char* v = VGA_MEM;
    let int n = (VGA_ROWS - 1) * VGA_COLS * 2;
    let int i = 0;
    while (i < n) { v[i] = v[i + VGA_COLS * 2]; i += 1; }
    let int j = (VGA_ROWS - 1) * VGA_COLS;
    while (j < VGA_ROWS * VGA_COLS) { v[j * 2] = ' '; v[j * 2 + 1] = 0x07; j += 1; }
    return 0;
}

func vga_cursor(idx) {
    outb(0x3D4, 0x0E); outb(0x3D5, (idx >> 7) & 255);
    outb(0x3D4, 0x0F); outb(0x3D5, idx & 255);
    return 0;
}

func vga_putc(ch) {
    let char* v = VGA_MEM;
    let int* cp = VGA_CURSOR_ADDR;
    let int idx = cp[0];
    if (ch == 10) {
        idx = (idx / VGA_COLS + 1) * VGA_COLS;
    } else if (ch == 8) {
        if (idx % VGA_COLS > 0) { idx -= 1; v[idx * 2] = ' '; v[idx * 2 + 1] = 0x07; }
    } else if (ch == 9) {
        idx = (idx + 8) & ~7;
        if (idx % VGA_COLS >= VGA_COLS) { idx = (idx / VGA_COLS) * VGA_COLS; }
    } else if (ch >= 32 && ch < 127) {
        v[idx * 2] = ch; v[idx * 2 + 1] = 0x07;
        idx += 1;
    }
    if (idx >= VGA_ROWS * VGA_COLS) { vga_scroll(); idx = (VGA_ROWS - 1) * VGA_COLS; }
    cp[0] = idx;
    vga_cursor(idx);
    return 0;
}

func vga_clear() {
    let char* v = VGA_MEM;
    let int i = 0;
    while (i < VGA_ROWS * VGA_COLS) { v[i * 2] = ' '; v[i * 2 + 1] = 0x07; i += 1; }
    let int* cp = VGA_CURSOR_ADDR;
    cp[0] = 0;
    vga_cursor(0);
    return 0;
}
