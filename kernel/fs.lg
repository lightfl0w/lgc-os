@import "io.lg";

const FS_MAX_FILES = 4;
const FS_MAX_SIZE = 512;

let char fs_data[2048];
let char fs_names[64];
let int fs_used[4];
let int fs_len[4];

func fs_file_data(i) { return fs_data + i * FS_MAX_SIZE; }
func fs_name_data(i) { return fs_names + i * 16; }

func fs_name_eq(i, other) {
    let nd = fs_name_data(i);
    let int j = 0;
    while (1) {
        let a = mem_read8(nd, j);
        let c = mem_read8(other, j);
        if (a != c) { return 0; }
        if (a == 0) { return 1; }
        j += 1;
    }
    return 0;
}

func fs_create(name, buf, len) {
    let slot = -1; let i = 0;
    while (i < FS_MAX_FILES) { if (fs_used[i] == 0) { slot = i; i = FS_MAX_FILES; } i += 1; }
    if (slot < 0) { return -1; }
    let j = 0;
    while (mem_read8(name, j) != 0) { mem_write8(fs_name_data(slot), j, mem_read8(name, j)); j += 1; }
    mem_write8(fs_name_data(slot), j, 0);
    for j in 0..len { mem_write8(fs_file_data(slot), j, mem_read8(buf, j)); }
    fs_len[slot] = len;
    fs_used[slot] = 1;
    return slot;
}

func fs_open(name) {
    for i in 0..FS_MAX_FILES { if (fs_used[i] != 0) { if (fs_name_eq(i, name)) { return i; } } }
    return -1;
}

func fs_size(i) { return fs_len[i]; }

func fs_count() {
    let c = 0;
    for i in 0..FS_MAX_FILES { if (fs_used[i] != 0) { c += 1; } }
    return c;
}

func fs_read(i, dst, n) {
    let m = fs_len[i];
    if (n < m) { m = n; }
    for j in 0..m { mem_write8(dst, j, mem_read8(fs_file_data(i), j)); }
    return m;
}

func fs_list() {
    for i in 0..FS_MAX_FILES {
        if (fs_used[i] != 0) {
            serial_puts("  ");
            let j = 0;
            while (mem_read8(fs_name_data(i), j) != 0) { serial_putc(mem_read8(fs_name_data(i), j)); j += 1; }
            serial_puts("  (");
            serial_putn(fs_len[i]);
            serial_puts(" bytes)\n");
        }
    }
    return 0;
}
