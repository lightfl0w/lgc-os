@import "io.lg";

const FS_MAX_FILES = 4;
const FS_SLOT_BASE = 0x800000;
const FS_SLOT_STRIDE = 0x10000;
const FS_MAX_SIZE = 0x10000;
const FS_NAME_LEN = 32;

let char fs_names[128];
let int fs_used[4];
let int fs_len[4];
let int fs_pos[4];

func fs_file_data(i) { return FS_SLOT_BASE + i * FS_SLOT_STRIDE; }
func fs_name_data(i) { return fs_names + i * FS_NAME_LEN; }

func fs_name_eq(i, other) {
    let nd = fs_name_data(i);
    let int j = 0;
    while (1) {
        let a = mem_read8(nd, j);
        let c = mem_read8(other, j);
        if (a != c) { return 0; }
        if (a == 0) { return 1; }
        j += 1;
    }
    return 0;
}

func fs_set_name(slot, name) {
    let j = 0;
    while (mem_read8(name, j) != 0) { mem_write8(fs_name_data(slot), j, mem_read8(name, j)); j += 1; }
    mem_write8(fs_name_data(slot), j, 0);
    return 0;
}

func fs_preload(slot, name, len) {
    fs_set_name(slot, name);
    fs_len[slot] = len;
    fs_pos[slot] = 0;
    fs_used[slot] = 1;
    return 0;
}

func fs_create_slot(name) {
    let slot = -1; let i = 0;
    while (i < FS_MAX_FILES) { if (fs_used[i] == 0) { slot = i; i = FS_MAX_FILES; } i += 1; }
    if (slot < 0) { return -1; }
    fs_set_name(slot, name);
    fs_len[slot] = 0;
    fs_pos[slot] = 0;
    fs_used[slot] = 1;
    return slot;
}

func fs_open(name) {
    for i in 0..FS_MAX_FILES { if (fs_used[i] != 0) { if (fs_name_eq(i, name)) { return i; } } }
    return -1;
}

func fs_size(i) { return fs_len[i]; }

func fs_count() {
    let c = 0;
    for i in 0..FS_MAX_FILES { if (fs_used[i] != 0) { c += 1; } }
    return c;
}

func fs_list() {
    for i in 0..FS_MAX_FILES {
        if (fs_used[i] != 0) {
            serial_puts("  ");
            let j = 0;
            while (mem_read8(fs_name_data(i), j) != 0) { serial_putc(mem_read8(fs_name_data(i), j)); j += 1; }
            serial_puts("  (");
            serial_putn(fs_len[i]);
            serial_puts(" bytes)\n");
        }
    }
    return 0;
}
