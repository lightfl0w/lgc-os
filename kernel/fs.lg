@import "io.lg";
@import "ata.lg";

const FS_MAX_FILES = 20;
const FS_MAX_SIZE = 0x100000;
const FS_NAME_LEN = 32;

const FS_SCRATCH_BASE = 0x6000000;
const FS_SCRATCH_LIMIT = 0x8000000;

let char fs_names[640];
let int fs_used[20];
let int fs_len[20];
let int fs_addr[20];
let int fs_bump = FS_SCRATCH_BASE;

func fs_file_data(i) { return fs_addr[i]; }
func fs_name_data(i) { return fs_names + i * FS_NAME_LEN; }

func fs_name_eq(i, other) {
    let int off = 0;
    let int k = 0;
    while (mem_read8(other, k) != 0) { if (mem_read8(other, k) == 47) { off = k + 1; } k += 1; }
    let nd = fs_name_data(i);
    let int j = 0;
    while (1) {
        let a = mem_read8(nd, j);
        let c = mem_read8(other, off + j);
        if (a != c) { return 0; }
        if (a == 0) { return 1; }
        j += 1;
    }
    return 0;
}

func fs_set_name(slot, name) {
    let j = 0;
    while (mem_read8(name, j) != 0) { mem_write8(fs_name_data(slot), j, mem_read8(name, j)); j += 1; }
    mem_write8(fs_name_data(slot), j, 0);
    return 0;
}

func fs_preload(slot, name, addr, len) {
    fs_set_name(slot, name);
    fs_addr[slot] = addr;
    fs_len[slot] = len;
    fs_used[slot] = 1;
    return 0;
}

func fs_load_disk(slot, lba, nsect) {
    return ata_read(lba, nsect, fs_file_data(slot));
}

func fs_create_slot(name) {
    let slot = -1; let i = 0;
    while (i < FS_MAX_FILES) { if (fs_used[i] == 0) { slot = i; i = FS_MAX_FILES; } i += 1; }
    if (slot < 0) { return -1; }
    if (fs_bump + FS_MAX_SIZE > FS_SCRATCH_LIMIT) { return -1; }
    fs_set_name(slot, name);
    fs_addr[slot] = fs_bump;
    fs_bump = fs_bump + FS_MAX_SIZE;
    fs_len[slot] = 0;
    fs_used[slot] = 1;
    return slot;
}

func fs_open(name) {
    for i in 0..FS_MAX_FILES { if (fs_used[i] != 0) { if (fs_name_eq(i, name)) { return i; } } }
    return -1;
}

func fs_size(i) { return fs_len[i]; }

func fs_count() {
    let c = 0;
    for i in 0..FS_MAX_FILES { if (fs_used[i] != 0) { c += 1; } }
    return c;
}

func fs_list() {
    for i in 0..FS_MAX_FILES {
        if (fs_used[i] != 0) {
            serial_puts("  ");
            let j = 0;
            while (mem_read8(fs_name_data(i), j) != 0) { serial_putc(mem_read8(fs_name_data(i), j)); j += 1; }
            serial_puts("  (");
            serial_putn(fs_len[i]);
            serial_puts(" bytes)\n");
        }
    }
    return 0;
}
