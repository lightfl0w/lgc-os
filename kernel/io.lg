@import "vga.lg";

func serial_putc(ch) {
    outb(SERIAL_COM1, ch);
    vga_putc(ch);
    return 0;
}
func serial_getc() {
    while ((inb(SERIAL_LSR) & 1) == 0) { }
    return inb(SERIAL_COM1);
}
func serial_puts(a) { let char* s = a; let int i = 0; while (s[i] != 0) { serial_putc(s[i]); i += 1; } return 0; }
func serial_putn(n) {
    if (n == 0) { serial_putc('0'); return 0; }
    let char buf[8]; let int k = 0;
    while (n > 0) { buf[k] = '0' + n % 10; n /= 10; k += 1; }
    while (k > 0) { k -= 1; serial_putc(buf[k]); }
    return 0;
}
func serial_puthex(v) {
    let char d[17]; let int i = 16; d[16] = 0;
    while (i > 0) { let int n = v & 15; let int ch = n + 48; if (n >= 10) { ch = ch + 7; } d[i - 1] = ch; v = v >> 4; i -= 1; }
    let char* s = d; let int k = 0; while (s[k] != 0) { serial_putc(s[k]); k += 1; }
    return 0;
}

func mem_write8(base, off, v) { let char* p = base; p[off] = v; return 0; }
func mem_read8(base, off) { let char* p = base; return p[off] & 255; }
func mem_read16(base, off) { return mem_read8(base, off) | (mem_read8(base, off + 1) << 8); }
func mem_read32(base, off) { let int v = 0; let int i = 0; while (i < 4) { v = v | (mem_read8(base, off + i) << (i * 8)); i += 1; } return v; }
func mem_read64(base, off) { let int v = 0; let int i = 0; while (i < 8) { v = v | (mem_read8(base, off + i) << (i * 8)); i += 1; } return v; }
func mem_write16(base, off, v) { mem_write8(base, off, v); mem_write8(base, off + 1, v >> 8); return 0; }
func mem_write32(base, off, v) { let int i = 0; while (i < 4) { mem_write8(base, off + i, v >> (i * 8)); i += 1; } return 0; }
func mem_write64(base, off, v) { let int i = 0; while (i < 8) { mem_write8(base, off + i, v >> (i * 8)); i += 1; } return 0; }
