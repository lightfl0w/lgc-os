const ARENA = 1024;

let char arena[1024];
let int hof[16];
let int hln[16];
let int nhole = 0;
let int brk = 0;

func round8(n) { return (n + 7) & ~7; }

func hole_remove(i) {
    let int j = i;
    while (j < nhole - 1) { hof[j] = hof[j + 1]; hln[j] = hln[j + 1]; j += 1; }
    nhole -= 1;
    return 0;
}

func coalesce() {
    let int changed = 1;
    while (changed != 0) {
        changed = 0;
        let int a = 0;
        while (a < nhole) {
            let int b = 0;
            while (b < nhole) {
                if (a != b) { if (hof[a] + hln[a] == hof[b]) { hln[a] = hln[a] + hln[b]; hole_remove(b); changed = 1; b = nhole; a = nhole; } }
                b += 1;
            }
            a += 1;
        }
    }
    return 0;
}

func heap_alloc(nbytes) {
    let int need = round8(nbytes);
    if (need == 0) { need = 8; }
    let int i = 0;
    while (i < nhole) {
        if (hln[i] >= need) {
            let int off = hof[i]; hof[i] = off + need; hln[i] = hln[i] - need;
            if (hln[i] == 0) { hole_remove(i); }
            return off;
        }
        i += 1;
    }
    if (brk + need <= ARENA) { let int off = brk; brk = brk + need; return off; }
    return -1;
}

func heap_free(off, nbytes) {
    let int size = round8(nbytes);
    if (nhole >= 16) { return -1; }
    hof[nhole] = off; hln[nhole] = size; nhole += 1; coalesce(); return 0;
}
