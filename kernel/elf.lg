@import "io.lg";

func elf_load(image) {
    let int entry = mem_read64(image, 24);
    let int phoff = mem_read64(image, 32);
    let int phes = mem_read16(image, 54);
    let int phnum = mem_read16(image, 56);
    let int i = 0;
    while (i < phnum) {
        let int base = phoff + i * phes;
        if (mem_read32(image, base) == 1) {
            let int po = mem_read64(image, base + 8);
            let int pv = mem_read64(image, base + 16);
            let int fsz = mem_read64(image, base + 32);
            let int msz = mem_read64(image, base + 40);
            let char* dst = pv;
            let int j = 0;
            while (j < fsz) { dst[j] = mem_read8(image, po + j); j += 1; }
            while (j < msz) { dst[j] = 0; j += 1; }
        }
        i += 1;
    }
    return entry;
}
