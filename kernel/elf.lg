@import "io.lg";

func elf_load(image) {
    let entry = mem_read64(image, 24);
    let phoff = mem_read64(image, 32);
    let phes = mem_read16(image, 54);
    let phnum = mem_read16(image, 56);
    for i in 0..phnum {
        let base = phoff + i * phes;
        if (mem_read32(image, base) == 1) {
            let po = mem_read64(image, base + 8);
            let pv = mem_read64(image, base + 16);
            let fsz = mem_read64(image, base + 32);
            let msz = mem_read64(image, base + 40);
            let char* dst = pv;
            for j in 0..fsz { dst[j] = mem_read8(image, po + j); }
            for j in fsz..msz { dst[j] = 0; }
        }
    }
    return entry;
}
