@boot;

const COM1 = 0x3F8;
const IDT = 0x120000;
const IDTR = 0x121000;
const GDT_CODE = 0x18;
const TYPE_ATTR = 0x8E;
const SCREEN = 0xB8000;

const PIT_CH0 = 0x40;
const PIT_CMD = 0x43;
const PIC_CMD = 0x20;
const PIC_DATA = 0x21;
const PIC_EOI = 0x20;

let int ticks = 0;

func putb(a, off, val) { let char* p = a; p[off] = val; return 0; }

func serial_putc(ch) { outb(COM1, ch); return 0; }

func serial_puts(a) {
    let char* s = a;
    let int i = 0;
    while (s[i] != 0) { serial_putc(s[i]); i += 1; }
    return 0;
}

func serial_putn(n) {
    if (n == 0) { serial_putc('0'); return 0; }
    let char buf[8];
    let int k = 0;
    while (n > 0) { buf[k] = '0' + n % 10; n /= 10; k += 1; }
    while (k > 0) { k -= 1; serial_putc(buf[k]); }
    return 0;
}

func screen_putc(pos, ch) {
    let char* vid = SCREEN;
    vid[pos * 2] = ch;
    vid[pos * 2 + 1] = 0x0F;
    return pos + 1;
}

func screen_puts(a) {
    let char* s = a;
    let int pos = 0;
    let int i = 0;
    while (s[i] != 0) { pos = screen_putc(pos, s[i]); i += 1; }
    return pos;
}

naked func irq0_isr() {
    asm(0x50,0x51,0x52,0x53,0x55,0x56,0x57,0x41,0x50,0x41,0x51,0x41,0x52,0x41,0x53,0x41,0x54,0x41,0x55,0x41,0x56,0x41,0x57);
    ticks += 1;
    outb(PIC_CMD, PIC_EOI);
    asm(0x41,0x5f,0x41,0x5e,0x41,0x5d,0x41,0x5c,0x41,0x5b,0x41,0x5a,0x41,0x59,0x41,0x58,0x5f,0x5e,0x5d,0x5b,0x5a,0x59,0x58,0x48,0xcf);
}

func idt_set(vec, handler) {
    let int* d = IDT;
    d[vec * 2]     = (handler & 0xFFFF) | (GDT_CODE << 16) | (TYPE_ATTR << 40) | (((handler >> 16) & 0xFFFF) << 48);
    d[vec * 2 + 1] = (handler >> 32) & 0xFFFFFFFF;
    return 0;
}

func idt_load() {
    putb(IDTR, 0, 0xFF); putb(IDTR, 1, 0x0F);
    let int i = 0;
    while (i < 8) { putb(IDTR, 2 + i, (IDT >> (i * 8)) & 0xFF); i += 1; }
    lidt(IDTR);
    return 0;
}

func pic_init() {
    outb(PIC_CMD, 0x11);
    outb(PIC_DATA, 0x20);
    outb(PIC_DATA, 0x04);
    outb(PIC_DATA, 0x01);
    outb(PIC_DATA, 0xFE);
    return 0;
}

func pit_init(div) {
    outb(PIT_CMD, 0x36);
    outb(PIT_CH0, div & 0xFF);
    outb(PIT_CH0, (div >> 8) & 0xFF);
    return 0;
}

func main() {
    serial_puts("lgc-os: IDT + PIT/PIC IRQ0 timer\n");
    screen_puts("lgc-os timer");

    idt_set(32, addr(irq0_isr));
    idt_load();
    pic_init();
    pit_init(1193);

    sti();

    let int shown = 0;
    while (1) {
        let int t = ticks;
        if (t - shown >= 1000) {
            shown = t;
            serial_puts("tick, uptime seconds=");
            serial_putn(t / 1000);
            serial_putc('\n');
        }
    }
    return 0;
}
