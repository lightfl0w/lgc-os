@boot;
@import "io.lg";
@import "core.lg";
@import "heap.lg";
@import "fs.lg";
@import "elf.lg";
@import "usrelf.lg";
@import "shell.lg";

let char usr_elf_image[512];

func main() {
    vga_clear();
    kbd_init();
    serial_puts("lgc-os booting: gdt/idt/paging/pic/pit...\n");
    gdt_init();
    paging_mark_user();
    idt_set_gate(0x80, addr(syscall_isr), 3);
    idt_set_gate(32, addr(irq0_isr), 0);
    idt_set_gate(13, addr(fault_gp), 0);
    idt_set_gate(14, addr(fault_pf), 0);
    idt_load();
    pic_init();
    pit_init(1193);
    sti();

    let char* sp = usr_elf_image;
    let fsize = usrelf_bytes(sp);
    fs_create("init.elf", sp, fsize);

    sh_run();
    return 0;
}
