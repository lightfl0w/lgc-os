    mem_write32(dst, 108, 0x00000000);
    mem_write32(dst, 112, 0x00001000);
    mem_write32(dst, 116, 0x00000000);
    mem_write32(dst, 120, 0x000001b8);
    mem_write32(dst, 124, 0x0001bf00);
    mem_write32(dst, 128, 0x22be0000);
    mem_write32(dst, 132, 0xba001800);
    mem_write32(dst, 136, 0x00000006);
    mem_write32(dst, 140, 0x3cb8050f);
    mem_write32(dst, 144, 0xbf000000);
    mem_write32(dst, 148, 0x0000002a);
    mem_write32(dst, 152, 0x4952050f);
    mem_write32(dst, 156, 0x2133474e);
    mem_write8(dst, 160, 0);
    return 161;
}
