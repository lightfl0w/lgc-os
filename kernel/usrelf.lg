@import "io.lg";

const USRELF_LEN = 161;

func usrelf_bytes(dst) {
    mem_write32(dst, 0, 0x464c457f);
    mem_write32(dst, 4, 0x00010102);
    mem_write32(dst, 8, 0x00000000);
    mem_write32(dst, 12, 0x00000000);
    mem_write32(dst, 16, 0x003e0002);
    mem_write32(dst, 20, 0x00000001);
    mem_write32(dst, 24, 0x00180000);
    mem_write32(dst, 28, 0x00000000);
