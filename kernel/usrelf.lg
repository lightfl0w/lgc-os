    mem_write32(dst, 36, 0x00000000);
    mem_write32(dst, 40, 0x00000000);
    mem_write32(dst, 44, 0x00000000);
    mem_write32(dst, 48, 0x00000000);
    mem_write32(dst, 52, 0x00380040);
    mem_write32(dst, 56, 0x00000001);
    mem_write32(dst, 60, 0x00000000);
    mem_write32(dst, 64, 0x00000001);
    mem_write32(dst, 68, 0x00000005);
    mem_write32(dst, 72, 0x00000078);
    mem_write32(dst, 76, 0x00000000);
    mem_write32(dst, 80, 0x00180000);
    mem_write32(dst, 84, 0x00000000);
    mem_write32(dst, 88, 0x00180000);
    mem_write32(dst, 92, 0x00000000);
    mem_write32(dst, 96, 0x00000029);
    mem_write32(dst, 100, 0x00000000);
