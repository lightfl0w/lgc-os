    b_p32(dst, 44, 0x00000000);
    b_p32(dst, 48, 0x00000000);
    b_p32(dst, 52, 0x00380040);
    b_p32(dst, 56, 0x00000001);
    b_p32(dst, 60, 0x00000000);
    b_p32(dst, 64, 0x00000001);
    b_p32(dst, 68, 0x00000005);
    b_p32(dst, 72, 0x00000078);
    b_p32(dst, 76, 0x00000000);
    b_p32(dst, 80, 0x00180000);
