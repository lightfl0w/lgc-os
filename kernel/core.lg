@import "mm.lg";
@import "fs.lg";

const IDT_BASE = 0x120000;
const IDTR_BASE = 0x121000;

const PG_PML4 = 0x1000;
const PG_PDPT = 0x2000;
const PG_PD = 0x3000;
const PG_PT = 0x4000;
const BOOT_INFO = 0x5000;
const GDT_BASE = 0x140000;
const TSS_BASE = 0x141000;
const GDTR_BASE = 0x142000;
const KSTACK_TOP = 0x151000;
const TRAP_FRAME = 0x150F60;
const RING0_CTX = 0x150FF0;
const RING0_RSP = 0x80000;
const SYSCALL_STACK_TOP = 0x150000;
const SYS_LSTAR = 0x160000;
const SYSCTX = 0x160100;
const SYS_RSP = 0x160200;
const USER_CODE = 0x180000;
const USER_STACK_TOP = 0xE00000;
const BRK_LIMIT = 0xC00000;
const U_MMAP_BASE = 0xC00000;
const U_MMAP_LIMIT = 0xE00000;
const MSR_SCRATCH = 0x161000;
const MSR_FS_BASE = 0xC0000100;
const SEL_UCODE = 0x33;
const SEL_UDATA = 0x2B;
const FD_MAX = 16;

let int pit_ticks = 0;
let int user_exit_code = 0;
let int u_brk = 0;
let int u_mmap_next = 0;
let int u_fs_base = 0;
let int rng_state = 0;
let int fd_kind[16];
let int fd_slot[16];
let int fd_pos[16];
let char dir_tmp[64];
let int trace_sys = 0;

func fd_reset() {
    let i = 0;
    while (i < FD_MAX) { fd_kind[i] = 0; fd_slot[i] = 0; fd_pos[i] = 0; i += 1; }
    fd_kind[0] = 1; fd_kind[1] = 1; fd_kind[2] = 1;
    return 0;
}

func fd_alloc(kind) {
    let i = 0;
    while (i < FD_MAX) {
        if (fd_kind[i] == 0) { fd_kind[i] = kind; fd_slot[i] = 0; fd_pos[i] = 0; return i; }
        i += 1;
    }
    return 0 - 24;
}

func gdt_make_desc(base, limit, access, flags) {
    let int q = limit & 0xFFFF;
    q = q | ((base & 0xFFFFFF) << 16);
    q = q | (access << 40);
    q = q | (((limit >> 16) & 0xF) << 48);
    q = q | (flags << 52);
    q = q | (((base >> 24) & 0xFF) << 56);
    return q;
}

func gdt_init() {
    let int* g = GDT_BASE;
    let cq0 = gdt_make_desc(0, 0xFFFFF, 0x9A, 0xA);
    let dq0 = gdt_make_desc(0, 0xFFFFF, 0x92, 0xC);
    let cq3 = gdt_make_desc(0, 0xFFFFF, 0xFA, 0xA);
    let dq3 = gdt_make_desc(0, 0xFFFFF, 0xF2, 0xC);
    let tq0 = gdt_make_desc(TSS_BASE, 103, 0x89, 0);
    g[0] = 0;
    g[1] = cq0; g[2] = dq0;
    g[3] = cq0; g[4] = dq0;
    g[5] = dq3; g[6] = cq3; g[7] = tq0;
    let char* t = TSS_BASE;
    for i in 0..26 { t[i] = 0; }
    for j in 0..8 { t[4 + j] = (KSTACK_TOP >> (j * 8)) & 255; }
    let int* r = GDTR_BASE;
    r[0] = 111 | (GDT_BASE << 16);
    lgdt(GDTR_BASE);
    asm(0xB8, 0x38, 0x00, 0x00, 0x00, 0x0F, 0x00, 0xD8);
    return 0;
}

func paging_mark_user() {
    let int* pml4 = PG_PML4;
    let int* pdpt = PG_PDPT;
    let int* pd = PG_PD;
    pml4[0] = pml4[0] | 0x04;
    pdpt[0] = pdpt[0] | 0x04;
    pd[0] = pd[0] | 0x04;
    setcr3(PG_PML4);
    return 0;
}

func paging_wx() {
    let int* pml4 = PG_PML4;
    let int* pdpt = PG_PDPT;
    let int* pd = PG_PD;
    let int* pt = PG_PT;
    for i in 0..512 { pt[i] = (i << 12) | 0x8000000000000003; }
    let int kend = mem_read32(BOOT_INFO, 0);
    if ((kend <= 0x100000) || (kend > 0x120000)) { kend = 0x120000; }
    let kn = (kend - 0x100000) >> 12;
    for k in 0..kn {
        let int idx = 0x100 + k;
        pt[idx] = (idx << 12) | 1;
    }
    for j in 0x180..0x200 { pt[j] = (j << 12) | 7; }
    pd[0] = 0x4007;
    pd[1] = 0x200000 | 0x87;
    pd[2] = 0x400000 | 0x87;
    pd[3] = 0x600000 | 0x87;
    pd[4] = 0x800000 | 0x87;
    pd[5] = 0xA00000 | 0x87;
    pd[6] = 0xC00000 | 0x87;
    pd[7] = 0xE00000 | 0x87;
    for r in 8..0x40 { pd[r] = (r << 21) | 0x83; }
    pml4[0] = pml4[0] | 0x04;
    pdpt[0] = pdpt[0] | 0x04;
    asm(0x0F, 0x20, 0xC0, 0x0D, 0x00, 0x00, 0x01, 0x00, 0x0F, 0x22, 0xC0);
    asm(0x0F, 0x20, 0xC0, 0x48, 0x83, 0xC8, 0x02, 0x48, 0x83, 0xE0, 0xFB, 0x0F, 0x22, 0xC0);
    asm(0x0F, 0x20, 0xE0, 0x48, 0x0D, 0x00, 0x06, 0x00, 0x00, 0x0F, 0x22, 0xE0);
    setcr3(PG_PML4);
    return 0;
}

func idt_set_gate(vec, handler, dpl) {
    let int* d = IDT_BASE;
    let int attr = 0x8E | (dpl << 5);
    d[vec * 2]     = (handler & 0xFFFF) | (0x08 << 16) | (attr << 40) | (((handler >> 16) & 0xFFFF) << 48);
    d[vec * 2 + 1] = (handler >> 32) & 0xFFFFFFFF;
    return 0;
}
func idt_load() {
    let char* p = IDTR_BASE;
    p[0] = 0xFF; p[1] = 0x0F;
    for i in 0..8 { p[2 + i] = (IDT_BASE >> (i * 8)) & 0xFF; }
    lidt(IDTR_BASE);
    return 0;
}

func pic_init() {
    outb(0x20, 0x11); outb(0x21, 0x20); outb(0x21, 0x04); outb(0x21, 0x01); outb(0x21, 0xFE);
    return 0;
}
func pit_init(div) { let d = div; outb(0x43, 0x36); outb(0x40, d & 0xFF); outb(0x40, (d >> 8) & 0xFF); return 0; }

func irq0_handler() { pit_ticks += 1; outb(0x20, 0x20); return 0; }

naked func irq0_isr() {
    asm(0x50,0x51,0x52,0x53,0x55,0x56,0x57,0x41,0x50,0x41,0x51,0x41,0x52,0x41,0x53,0x41,0x54,0x41,0x55,0x41,0x56,0x41,0x57);
    irq0_handler();
    asm(0x41,0x5f,0x41,0x5e,0x41,0x5d,0x41,0x5c,0x41,0x5b,0x41,0x5a,0x41,0x59,0x41,0x58,0x5f,0x5e,0x5d,0x5b,0x5a,0x59,0x58,0x48,0xcf);
}

func sys_dispatch(r) {
    let int* f = r;
    let nr = f[0];
    if (nr == 0) { serial_putc(f[6]); return 0; }
    if (nr == 2) { serial_puts(f[6]); return 0; }
    if (nr == 1) {
        user_exit_code = f[6];
        let int* c = RING0_CTX;
        c[0] = addr(sh_resume);
        c[1] = RING0_RSP;
        return 1;
    }
    f[0] = -1;
    return 0;
}

naked func syscall_isr() {
    asm(0x41,0x57, 0x41,0x56, 0x41,0x55, 0x41,0x54, 0x41,0x53, 0x41,0x52, 0x41,0x51, 0x41,0x50,
        0x57, 0x56, 0x55, 0x53, 0x52, 0x51, 0x50);
    sys_dispatch(TRAP_FRAME);
    asm(0x48,0x85,0xC0, 0x75,0x19,
        0x58, 0x59, 0x5A, 0x5B, 0x5D, 0x5E, 0x5F,
        0x41,0x58, 0x41,0x59, 0x41,0x5A, 0x41,0x5B, 0x41,0x5C, 0x41,0x5D, 0x41,0x5E, 0x41,0x5F,
        0x48,0xCF,
        0x48,0xA1, 0xF8,0x0F,0x15,0x00,0x00,0x00,0x00,0x00,
        0x48,0x89,0xC4,
        0x48,0xA1, 0xF0,0x0F,0x15,0x00,0x00,0x00,0x00,0x00,
        0xFF,0xE0);
}

func syscall_init() {
    mem_write64(SYS_LSTAR, 0, addr(syscall_entry));
    syscall_msr_setup();
    return 0;
}

naked func syscall_msr_setup() {
    asm(
        0x48,0x8B,0x04,0x25, 0x00,0x00,0x16,0x00,
        0x31,0xD2,
        0xB9,0x82,0x00,0x00,0xC0,
        0x0F,0x30,
        0xB9,0x81,0x00,0x00,0xC0,
        0xBA,0x08,0x00,0x20,0x00,
        0x31,0xC0,
        0x0F,0x30,
        0xB9,0x84,0x00,0x00,0xC0,
        0xB8,0x00,0x02,0x00,0x00,
        0x31,0xD2,
        0x0F,0x30,
        0xB9,0x80,0x00,0x00,0xC0,
        0x0F,0x32,
        0x83,0xC8,0x01,
        0x0F,0x30);
    return 0;
}

naked func syscall_entry() {
    asm(
        0x48,0x89,0x24,0x25, 0x00,0x02,0x16,0x00,
        0x48,0xBC, 0x00,0x00,0x15,0x00,0x00,0x00,0x00,0x00,
        0x48,0x89,0x04,0x25, 0x00,0x01,0x16,0x00,
        0x48,0x89,0x0C,0x25, 0x08,0x01,0x16,0x00,
        0x48,0x89,0x14,0x25, 0x10,0x01,0x16,0x00,
        0x48,0x89,0x1C,0x25, 0x18,0x01,0x16,0x00,
        0x48,0x89,0x2C,0x25, 0x20,0x01,0x16,0x00,
        0x48,0x89,0x34,0x25, 0x28,0x01,0x16,0x00,
