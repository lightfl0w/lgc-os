        0x4C,0x89,0x0C,0x25, 0x40,0x01,0x16,0x00,
        0x4C,0x89,0x14,0x25, 0x48,0x01,0x16,0x00,
        0x4C,0x89,0x1C,0x25, 0x50,0x01,0x16,0x00,
        0x4C,0x89,0x24,0x25, 0x58,0x01,0x16,0x00,
