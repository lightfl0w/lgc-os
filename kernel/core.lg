const IDT_BASE = 0x120000;
const IDTR_BASE = 0x121000;

const PG_PML4 = 0x1000;
const PG_PDPT = 0x2000;
const PG_PD = 0x3000;
const GDT_BASE = 0x140000;
const TSS_BASE = 0x141000;
const GDTR_BASE = 0x142000;
const KSTACK_TOP = 0x151000;
const TRAP_FRAME = 0x150F60;
const RING0_CTX = 0x150FF0;
const RING0_RSP = 0x80000;
const USER_CODE = 0x180000;
const USER_STACK = 0x1A0000;
const SEL_UCODE = 0x63;
const SEL_UDATA = 0x6B;

let int pit_ticks = 0;
let int user_exit_code = 0;

func gdt_make_desc(base, limit, access, flags) {
    let int q = limit & 0xFFFF;
    q = q | ((base & 0xFFFFFF) << 16);
    q = q | (access << 40);
    q = q | (((limit >> 16) & 0xF) << 48);
    q = q | (flags << 52);
    q = q | (((base >> 24) & 0xFF) << 56);
    return q;
}

func gdt_init() {
    let int* g = GDT_BASE;
    let int cq0 = gdt_make_desc(0, 0xFFFFF, 0x9A, 0xA);
    let int dq0 = gdt_make_desc(0, 0xFFFFF, 0x92, 0xC);
    let int cq3 = gdt_make_desc(0, 0xFFFFF, 0xFA, 0xA);
    let int dq3 = gdt_make_desc(0, 0xFFFFF, 0xF2, 0xC);
    let int tq0 = gdt_make_desc(TSS_BASE, 103, 0x89, 0);
    g[0] = 0;
    g[1] = cq0; g[2] = dq0;
    g[3] = cq0; g[4] = dq0;
    g[5] = tq0; g[6] = 0;
    g[12] = cq3; g[13] = dq3;
    let char* t = TSS_BASE;
    let int i = 0;
    while (i < 26) { t[i] = 0; i += 1; }
    let int j = 0;
    while (j < 8) { t[4 + j] = (KSTACK_TOP >> (j * 8)) & 255; j += 1; }
    let int* r = GDTR_BASE;
    r[0] = 111 | (GDT_BASE << 16);
    lgdt(GDTR_BASE);
    asm(0xB8, 0x28, 0x00, 0x00, 0x00, 0x0F, 0x00, 0xD8);
    return 0;
}

func paging_mark_user() {
    let int* pml4 = PG_PML4;
    let int* pdpt = PG_PDPT;
    let int* pd = PG_PD;
    pml4[0] = pml4[0] | 0x04;
    pdpt[0] = pdpt[0] | 0x04;
    pd[0] = pd[0] | 0x04;
    setcr3(PG_PML4);
    return 0;
}

func idt_set_gate(vec, handler, dpl) {
    let int* d = IDT_BASE;
    let int attr = 0x8E | (dpl << 5);
    d[vec * 2]     = (handler & 0xFFFF) | (0x08 << 16) | (attr << 40) | (((handler >> 16) & 0xFFFF) << 48);
    d[vec * 2 + 1] = (handler >> 32) & 0xFFFFFFFF;
    return 0;
}
func idt_load() {
    let char* p = IDTR_BASE;
    p[0] = 0xFF; p[1] = 0x0F;
    let int i = 0;
    while (i < 8) { p[2 + i] = (IDT_BASE >> (i * 8)) & 0xFF; i += 1; }
    lidt(IDTR_BASE);
    return 0;
}

func pic_init() {
    outb(0x20, 0x11); outb(0x21, 0x20); outb(0x21, 0x04); outb(0x21, 0x01); outb(0x21, 0xFE);
    return 0;
}
func pit_init(div) { let int d = div; outb(0x43, 0x36); outb(0x40, d & 0xFF); outb(0x40, (d >> 8) & 0xFF); return 0; }

func irq0_handler() { pit_ticks += 1; outb(0x20, 0x20); return 0; }

naked func irq0_isr() {
    asm(0x50,0x51,0x52,0x53,0x55,0x56,0x57,0x41,0x50,0x41,0x51,0x41,0x52,0x41,0x53,0x41,0x54,0x41,0x55,0x41,0x56,0x41,0x57);
    irq0_handler();
    asm(0x41,0x5f,0x41,0x5e,0x41,0x5d,0x41,0x5c,0x41,0x5b,0x41,0x5a,0x41,0x59,0x41,0x58,0x5f,0x5e,0x5d,0x5b,0x5a,0x59,0x58,0x48,0xcf);
}

func sys_dispatch(r) {
    let int* f = r;
    let int nr = f[0];
    if (nr == 0) { serial_putc(f[6]); return 0; }
    if (nr == 2) { serial_puts(f[6]); return 0; }
    if (nr == 1) {
        user_exit_code = f[6];
        let int* c = RING0_CTX;
        c[0] = addr(sh_resume);
        c[1] = RING0_RSP;
        return 1;
    }
    f[0] = -1;
    return 0;
}

naked func syscall_isr() {
    asm(0x41,0x57, 0x41,0x56, 0x41,0x55, 0x41,0x54, 0x41,0x53, 0x41,0x52, 0x41,0x51, 0x41,0x50,
        0x57, 0x56, 0x55, 0x53, 0x52, 0x51, 0x50);
    sys_dispatch(TRAP_FRAME);
    asm(0x48,0x85,0xC0, 0x75,0x19,
        0x58, 0x59, 0x5A, 0x5B, 0x5D, 0x5E, 0x5F,
        0x41,0x58, 0x41,0x59, 0x41,0x5A, 0x41,0x5B, 0x41,0x5C, 0x41,0x5D, 0x41,0x5E, 0x41,0x5F,
        0x48,0xCF,
        0x48,0xA1, 0xF8,0x0F,0x15,0x00,0x00,0x00,0x00,0x00,
        0x48,0x89,0xC4,
        0x48,0xA1, 0xF0,0x0F,0x15,0x00,0x00,0x00,0x00,0x00,
        0xFF,0xE0);
}

naked func fault_gp() {
    asm(0x66, 0xBA, 0xF8, 0x03, 0xB0, 0x5B, 0xEE, 0xB0, 0x47, 0xEE, 0xB0, 0x50, 0xEE, 0xB0, 0x5D, 0xEE, 0xEB, 0xFE);
}
naked func fault_pf() {
    asm(0x66, 0xBA, 0xF8, 0x03, 0xB0, 0x5B, 0xEE, 0xB0, 0x50, 0xEE, 0xB0, 0x46, 0xEE, 0xB0, 0x5D, 0xEE, 0xEB, 0xFE);
}

naked func user_enter(frame) {
    asm(0x48, 0x89, 0xFC, 0x48, 0xCF);
}
