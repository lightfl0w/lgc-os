const IDT = 0x120000;
const IDTR = 0x121000;

const PML4 = 0x1000;
const PDPT = 0x2000;
const PD_LO = 0x3000;
const GDT_TABLE = 0x140000;
const TSSB = 0x141000;
const GDTR = 0x142000;
const KSTACK = 0x151000;
const USERCODE = 0x180000;
const USTACK = 0x1A0000;
const CS3 = 0x63;
const SS3 = 0x6B;

let int ticks = 0;

func make_desc_q0(base, limit, access, flags) {
    let int q = limit & 0xFFFF;
    q = q | ((base & 0xFFFFFF) << 16);
    q = q | (access << 40);
    q = q | (((limit >> 16) & 0xF) << 48);
    q = q | (flags << 52);
    q = q | (((base >> 24) & 0xFF) << 56);
    return q;
}

func gdt_init() {
    let int* g = GDT_TABLE;
    let int cq0 = make_desc_q0(0, 0xFFFFF, 0x9A, 0xA);
    let int dq0 = make_desc_q0(0, 0xFFFFF, 0x92, 0xC);
    let int cq3 = make_desc_q0(0, 0xFFFFF, 0xFA, 0xA);
    let int dq3 = make_desc_q0(0, 0xFFFFF, 0xF2, 0xC);
    let int tq0 = make_desc_q0(TSSB, 103, 0x89, 0);
    g[0] = 0;
    g[1] = cq0; g[2] = dq0;
    g[3] = cq0; g[4] = dq0;
    g[5] = tq0; g[6] = 0;
    g[12] = cq3; g[13] = dq3;
    let char* t = TSSB;
    let int i = 0;
    while (i < 26) { t[i] = 0; i += 1; }
    let int j = 0;
    while (j < 8) { t[4 + j] = (KSTACK >> (j * 8)) & 255; j += 1; }
    let int* r = GDTR;
    r[0] = 111 | (GDT_TABLE << 16);
    lgdt(GDTR);
    asm(0xB8, 0x28, 0x00, 0x00, 0x00, 0x0F, 0x00, 0xD8);
    return 0;
}

func mark_user_pages() {
    let int* pml4 = PML4;
    let int* pdpt = PDPT;
    let int* pd = PD_LO;
    pml4[0] = pml4[0] | 0x04;
    pdpt[0] = pdpt[0] | 0x04;
    pd[0] = pd[0] | 0x04;
    setcr3(PML4);
    return 0;
}

func idt_set_dpl(vec, handler, dpl) {
    let int* d = IDT;
    let int attr = 0x8E | (dpl << 5);
    d[vec * 2]     = (handler & 0xFFFF) | (0x08 << 16) | (attr << 40) | (((handler >> 16) & 0xFFFF) << 48);
    d[vec * 2 + 1] = (handler >> 32) & 0xFFFFFFFF;
    return 0;
}
func idt_load() {
    let char* p = IDTR;
    p[0] = 0xFF; p[1] = 0x0F;
    let int i = 0;
    while (i < 8) { p[2 + i] = (IDT >> (i * 8)) & 0xFF; i += 1; }
    lidt(IDTR);
    return 0;
}

func pic_init() {
    outb(0x20, 0x11); outb(0x21, 0x20); outb(0x21, 0x04); outb(0x21, 0x01); outb(0x21, 0xFE);
    return 0;
}
func pit_init(div) { let int d = div; outb(0x43, 0x36); outb(0x40, d & 0xFF); outb(0x40, (d >> 8) & 0xFF); return 0; }

func irq0_handler() { ticks += 1; outb(0x20, 0x20); return 0; }

naked func irq0_isr() {
    asm(0x50,0x51,0x52,0x53,0x55,0x56,0x57,0x41,0x50,0x41,0x51,0x41,0x52,0x41,0x53,0x41,0x54,0x41,0x55,0x41,0x56,0x41,0x57);
    irq0_handler();
    asm(0x41,0x5f,0x41,0x5e,0x41,0x5d,0x41,0x5c,0x41,0x5b,0x41,0x5a,0x41,0x59,0x41,0x58,0x5f,0x5e,0x5d,0x5b,0x5a,0x59,0x58,0x48,0xcf);
}

naked func syscall_write_char() {
    asm(0x50, 0x57, 0x56,
        0x48, 0x89, 0xF8,
        0x66, 0xBA, 0xF8, 0x03, 0xEE,
        0x48, 0x8B, 0x34, 0x25, 0x00, 0x00, 0x17, 0x00,
        0x48, 0xC1, 0xE6, 0x01,
        0x48, 0x81, 0xC6, 0x00, 0x80, 0x0B, 0x00,
        0x88, 0x06,
        0xC6, 0x46, 0x01, 0x07,
        0x48, 0x8B, 0x04, 0x25, 0x00, 0x00, 0x17, 0x00,
        0x48, 0xFF, 0xC0,
        0x48, 0x89, 0x04, 0x25, 0x00, 0x00, 0x17, 0x00,
        0x5E, 0x5F, 0x58, 0x48, 0xCF);
}

naked func gp_fault() {
    asm(0x66, 0xBA, 0xF8, 0x03, 0xB0, 0x5B, 0xEE, 0xB0, 0x47, 0xEE, 0xB0, 0x50, 0xEE, 0xB0, 0x5D, 0xEE, 0xEB, 0xFE);
}
naked func pf_fault() {
    asm(0x66, 0xBA, 0xF8, 0x03, 0xB0, 0x5B, 0xEE, 0xB0, 0x50, 0xEE, 0xB0, 0x46, 0xEE, 0xB0, 0x5D, 0xEE, 0xEB, 0xFE);
}

naked func enter_user(frame) {
    asm(0x48, 0x89, 0xFC, 0x48, 0xCF);
}
